# The public host name that points at your server (Caddy gets a certificate for it).
POSTINO_DOMAIN=mail.example.com

# Used in push notification links. Same as the domain, with https://
POSTINO_BASE_URL=https://mail.example.com

# Encrypts the mailbox passwords at rest. Generate one with:
#   openssl rand -base64 32
# Keep it: without it the stored account passwords cannot be read.
# POSTINO_SECRET=<paste the output of: openssl rand -base64 32>

# Optional: size of the attachment cache in MB (default 2048). Older files are
# dropped first and fetched again from the mail server when opened.
# POSTINO_ATTACHMENT_CACHE_MB=2048

# Optional: Postino's own Google sign-in (one-time registration, see README
# "Google Drive"). With these set, Settings → Google Drive is one button.
# POSTINO_GOOGLE_CLIENT_ID=1234-abcd.apps.googleusercontent.com
# POSTINO_GOOGLE_CLIENT_SECRET=GOCSPX-...
