{
	# No request lines in Caddy's logs: the Segretario connector's URL carries its secret. The proxy's own errors
	# ("aborting with incomplete response") would print the upstream path, so they are excluded too.
	log default {
		output stderr
		exclude http.log.error http.handlers.reverse_proxy
	}
}

{$POSTINO_DOMAIN} {
	encode zstd gzip

	# Keep (keep-mcp) e WhatsApp NON hanno più un indirizzo pubblico (11/11/2026): i loro strumenti passano dal
	# connettore del Segretario, che li raggiunge sulla rete interna (172.17.0.1:8765 e whatsapp:8787).

	# Login (OAuth) del connettore del Segretario: i metadati stanno alla radice del dominio (RFC 8414, RFC 9728).
	handle /.well-known/oauth-protected-resource/segretario/* {
		reverse_proxy segretario:8766
	}
	handle /.well-known/oauth-authorization-server/segretario {
		rewrite * /.well-known/oauth-authorization-server
		reverse_proxy segretario:8766
	}
	handle /.well-known/openid-configuration/segretario {
		rewrite * /.well-known/oauth-authorization-server
		reverse_proxy segretario:8766
	}

	# Segretario (memoria condivisa per Claude): repo EmanueleZamboni/segretario, container sulla rete di Caddy.
	# Il segreto è nel percorso: niente access log.
	handle_path /segretario/* {
		reverse_proxy segretario:8766 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy postino:8025 {
			# Server-sent events must not be buffered.
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
