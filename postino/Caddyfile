{
	# No request lines in Caddy's error log: the Keep connector's URL carries its secret.
	log default {
		output stderr
		exclude http.log.error
	}
}

{$POSTINO_DOMAIN} {
	encode zstd gzip

	# Google Keep connector (keep-mcp) running on this same server, on the Docker bridge.
	# Without it installed this path just answers 502. Its secret is in the path: no access log.
	handle_path /keep/* {
		reverse_proxy 172.17.0.1:8765 {
			flush_interval -1
		}
	}

	# WhatsApp del Segretario (servizio separato da Postino, stesso repo del Segretario): segreto nel percorso.
	# Finché il container non esiste risponde 502, come Keep.
	handle_path /whatsapp/* {
		reverse_proxy whatsapp:8787 {
			flush_interval -1
		}
	}

	# Segretario (memoria condivisa per Claude): repo EmanueleZamboni/segretario, container sulla rete di Caddy.
	# Il segreto è nel percorso: niente access log.
	handle_path /segretario/* {
		reverse_proxy segretario:8766 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy postino:8025 {
			# Server-sent events must not be buffered.
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
